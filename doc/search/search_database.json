ntracule Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module.","tags":"","url":"proc/gridpoints2.html"},{"title":"gridpoints3 – INCA","text":"public  subroutine gridpoints3(center_i, step_i, np_i) Arguments Type Intent Optional Attributes Name double precision, intent(in), dimension(3) :: center_i double precision, intent(in), dimension(3) :: step_i integer, intent(in), dimension(3) :: np_i Calls proc~~gridpoints3~~CallsGraph proc~gridpoints3 gridpoints3 dmod dmod proc~gridpoints3->dmod Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Called by proc~~gridpoints3~~CalledByGraph proc~gridpoints3 gridpoints3 proc~calculate_intracule calculate_intracule proc~calculate_intracule->proc~gridpoints3 program~inca inca program~inca->proc~calculate_intracule Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine gridpoints3 ( center_i , step_i , np_i ) implicit none double precision , intent ( in ), dimension ( 3 ) :: center_i , step_i integer , intent ( in ), dimension ( 3 ) :: np_i !local variables integer :: i , j , k , sm double precision , dimension ( 3 ) :: xm rgrid = np_i ( 1 ) * np_i ( 2 ) * np_i ( 3 ) allocate ( rg ( 3 , rgrid )) rg = 0.d0 do i = 1 , 3 if ( dmod ( dble ( np_i ( i )), 2.d0 ). eq . 0.d0 ) then !even number xm ( i ) = center_i ( i ) - ( step_i ( i ) / 2.d0 ) - (( dble ( np_i ( i )) - 2.d0 ) / 2.d0 ) * step_i ( i ) else !odd number xm ( i ) = center_i ( i ) - (( dble ( np_i ( i )) - 1.d0 ) / 2.d0 ) * step_i ( i ) end if end do sm = 0 do i = 1 , np_i ( 1 ) !Depending on a calculates the point with a different function do j = 1 , np_i ( 2 ) do k = 1 , np_i ( 3 ) sm = sm + 1 rg ( 1 , sm ) = xm ( 1 ) + step_i ( 1 ) * ( i - 1 ) rg ( 2 , sm ) = xm ( 2 ) + step_i ( 2 ) * ( j - 1 ) rg ( 3 , sm ) = xm ( 3 ) + step_i ( 3 ) * ( k - 1 ) end do end do end do end subroutine gridpoints3","tags":"","url":"proc/gridpoints3.html"},{"title":"gridpoints3_corner – INCA","text":"public  subroutine gridpoints3_corner(center_i, step_i, np_i) Arguments Type Intent Optional Attributes Name double precision, intent(in), dimension(3) :: center_i double precision, intent(in), dimension(3) :: step_i integer, intent(in), dimension(3) :: np_i Source Code subroutine gridpoints3_corner ( center_i , step_i , np_i ) implicit none double precision , intent ( in ), dimension ( 3 ) :: center_i , step_i integer , intent ( in ), dimension ( 3 ) :: np_i integer :: i , j , k , sm double precision , dimension ( 3 ) :: xm ! Total number of grid points rgrid = np_i ( 1 ) * np_i ( 2 ) * np_i ( 3 ) allocate ( rg ( 3 , rgrid )) rg = 0.d0 ! Starting coordinate (corner reference) xm (:) = center_i (:) ! Fill grid sm = 0 do i = 1 , np_i ( 1 ) do j = 1 , np_i ( 2 ) do k = 1 , np_i ( 3 ) sm = sm + 1 rg ( 1 , sm ) = xm ( 1 ) + step_i ( 1 ) * ( i - 1 ) rg ( 2 , sm ) = xm ( 2 ) + step_i ( 2 ) * ( j - 1 ) rg ( 3 , sm ) = xm ( 3 ) + step_i ( 3 ) * ( k - 1 ) end do end do end do end subroutine gridpoints3_corner","tags":"","url":"proc/gridpoints3_corner.html"},{"title":"becke – INCA","text":"private  subroutine becke(rrg, sumq, rgrid, nquad, cent, w_beck, Ps) !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! Arguments Type Intent Optional Attributes Name double precision, intent(in), dimension(3,rgrid) :: rrg integer, dimension(nquad) :: sumq integer, intent(in) :: rgrid integer, intent(in) :: nquad double precision, intent(in), dimension(3,nquad) :: cent double precision, intent(out), dimension(rgrid) :: w_beck double precision, intent(in), dimension(nquad) :: Ps Called by proc~~becke~~CalledByGraph proc~becke becke proc~gridpoints gridpoints proc~gridpoints->proc~becke proc~calculate_intracule calculate_intracule proc~calculate_intracule->proc~gridpoints program~inca inca program~inca->proc~calculate_intracule Help Graph Key Nodes of different colours represent the following: Graph Key Subroutine Subroutine Function Function Interface Interface Type Bound Procedure Type Bound Procedure Unknown Procedure Type Unknown Procedure Type Program Program This Page's Entity This Page's Entity Solid arrows point from a procedure to one which it calls. Dashed \narrows point from an interface to procedures which implement that interface.\nThis could include the module procedures in a generic interface or the\nimplementation in a submodule of an interface in a parent module. Source Code subroutine becke ( rrg , sumq , rgrid , nquad , cent , w_beck , Ps ) !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! ! UPDATED: Now implements Salvador's TFVC scheme (JCP 139, 071103 2013)                    ! ! - Uses robust boundary shift for large size differences                                  ! ! - Uses k=4 stiffness parameter                                                           ! !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! implicit none integer , intent ( in ) :: rgrid , nquad !total grid, number of quadratures double precision , intent ( in ), dimension ( 3 , nquad ) :: cent !center of the quadratures double precision , intent ( in ), dimension ( 3 , rgrid ) :: rrg !(reduced) grid points double precision , intent ( in ), dimension ( nquad ) :: Ps !weight (POPULATION) of each center integer , dimension ( nquad ) :: sumq !number of grid points per quad. double precision , intent ( out ), dimension ( rgrid ) :: w_beck !becke weights for each point !local variables double precision , dimension ( rgrid , nquad ) :: w_becke !weights of different quad. centers at same point integer :: i1 , i , j , sm double precision , dimension ( nquad , nquad ) :: Rij , Xi !distance between centers, Xi = Chi ratio double precision , dimension ( nquad ) :: P !equation 13 double precision :: ri , rj , s_ij , Ptot double precision :: mu_ij , v_ij double precision :: term ! New local variable for Salvador's formula !compute R_ij and Xi (Chi) do i = 1 , nquad do j = 1 , nquad Rij ( i , j ) = dsqrt ( sum (( cent (:, i ) - cent (:, j )) ** 2.d0 )) !distance between centers ! TFVC CHANGE 1: Use Square Root of Population ratio ! If Ps contains \"pair counts\" (Volume), sqrt gives \"Radius\" ratio if ( Ps ( j ) . gt . 1.d-12 ) then !Xi(i,j) = dsqrt(Ps(i)/Ps(j)) Xi ( i , j ) = ( Ps ( i ) / Ps ( j )) ** ( 1.d0 / 3.d0 ) ! Volume ratio to the 1/3 gives Radius ratio else Xi ( i , j ) = 1.d0 ! Fallback if Pop is zero end if end do end do !compute Becke/TFVC weights from all centres for all the grid points w_becke = 0.d0 sm = 0 do i1 = 1 , rgrid !for all the grid points sm = sm + 1 !count grid points do i = 1 , nquad P ( i ) = 1.d0 do j = 1 , nquad if ( i . ne . j ) then ri = dsqrt ( sum (( rrg (:, i1 ) - cent (:, i )) ** 2.d0 )) !distance to center i rj = dsqrt ( sum (( rrg (:, i1 ) - cent (:, j )) ** 2.d0 )) !distance to center j ! 1. Calculate Standard Confocal Coordinate mu [-1, 1] if ( Rij ( i , j ) . gt . 1.d-12 ) then mu_ij = ( ri - rj ) * ( Rij ( i , j ) ** ( - 1.d0 )) !equation 11 else mu_ij = 0.d0 ! Should not happen if centers are merged end if ! 2. TFVC CHANGE 2: Salvador's Transformation (Eq 9 from Salvador's paper) ! This replaces Becke's Eq A2, A5, A6. ! Formula: v = (1 + mu - chi*(1-mu)) / (1 + mu + chi*(1-mu)) term = Xi ( i , j ) * ( 1.d0 - mu_ij ) v_ij = ( 1.d0 + mu_ij - term ) / ( 1.d0 + mu_ij + term ) ! 3. Cutoff Profile s_ij = 0.5d0 * ( 1.d0 - f_k ( v_ij )) !equation 21 P ( i ) = P ( i ) * s_ij !equation 13 end if end do w_becke ( i1 , i ) = P ( i ) !store weight of quadrature i at point i1 end do Ptot = sum ( P ) if ( Ptot . gt . 1.d-15 ) then w_becke ( i1 ,:) = w_becke ( i1 ,:) * ( Ptot ** ( - 1.d0 )) !normalize weight end if end do !store single becke weight for each grid point in a single array sm = 0 w_beck = 0.d0 do i = 1 , nquad do j = 1 , sumq ( i ) sm = sm + 1 w_beck ( sm ) = w_becke ( sm , i ) end do end do contains function f_k ( val ) !equation 20 implicit none double precision :: f_k double precision , intent ( in ) :: val double precision :: vl integer :: i ! TFVC CHANGE 3: Salvador recommends k=4 for this scheme integer , parameter :: k = 4 vl = val do i = 1 , k f_k = pf ( vl ) vl = f_k end do end function function pf ( vl ) !equation 19 implicit none double precision :: pf double precision , intent ( in ) :: vl pf = 1.5d0 * vl - 0.5d0 * vl ** ( 3.d0 ) end function end subroutine becke","tags":"","url":"proc/becke.html"},{"title":"calculate_intracule – INCA","text":"public  subroutine calculate_intracule(normalize_dm2p) !!!!!!!!!!!!!Following Cioslowski and Liu algorithm!!!!!!!!!!!!!!!\n!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! Arguments Type Intent Optional Attributes Name logical, intent(in) :: normalize_dm2p Calls proc~~calculate_intracule~~CallsGraph proc~calculate_intracule calculate_intracule dexp dexp proc~calculate_intracule->dexp omp_get_thread_num omp_get_thread_num proc~calculate_intracule->omp_get_thread_num omp_get_wtime omp_get_wtime proc~calculate_intracule->omp_get_wtime proc~dfact dfact proc~calculate_intracule->proc~dfact proc~gridpoints gridpoints proc~calculate_intracule->proc~gridpoints proc~gridpoints2 gridpoints2 proc~calculate_intracule->proc~gridpoints2 proc~gridpoints3 gridpoints3 proc~calculate_intracule->proc~gridpoints3 proc~init_gauherm init_gauherm proc~calculate_intracule->proc~init_gauherm proc~ja8 JA8 proc~calculate_intracule->proc~ja8 proc~polycoef polycoef proc~calculate_intracule->proc~polycoef proc~radial_smearing radial_smearing proc~calculate_intracule->proc~radial_smearing ld0006 ld0006 proc~gridpoints->ld0006 ld0014 ld0014 proc~gridpoints->ld0014 ld0026 ld0026 proc~gridpoints->ld0026 ld0038 ld0038 proc~gridpoints->ld0038 ld0050 ld0050 proc~gridpoints->ld0050 ld0074 ld0074 proc~gridpoints->ld0074 ld0086 ld0086 proc~gridpoints->ld0086 ld0110 ld0110 proc~gridpoints->ld0110 ld0146 ld0146 proc~gridpoints->ld0146 ld0170 ld0170 proc~gridpoints->ld0170 ld0194 ld0194 proc~gridpoints->ld0194 ld0230 ld0230 proc~gridpoints->ld0230 ld0266 ld0266 proc~gridpoints->ld0266 ld0302 ld0302 proc~gridpoints->ld0302 ld0350 ld0350 proc~gridpoints->ld0350 ld0434 ld0434 proc~gridpoints->ld0434 ld0590 ld0590 proc~gridpoints->ld0590 ld0770 ld0770 proc~gr